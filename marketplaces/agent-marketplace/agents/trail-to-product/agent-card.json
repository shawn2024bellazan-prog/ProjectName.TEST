{
    "name":  "Trail To Product Agent",
    "description":  "Draft agent that inspects the process of packaging a finished Trail as a marketplace product and guides and proposes fixes. Recommendation only; no tools, no grants.",
    "version":  "0.1.0",
    "supportedInterfaces":  [
                                {
                                    "url":  "https://agents.invalid/trail-to-product/a2a",
                                    "protocolBinding":  "JSONRPC",
                                    "protocolVersion":  "1.0"
                                }
                            ],
    "capabilities":  {
                         "streaming":  false,
                         "pushNotifications":  false,
                         "extendedAgentCard":  false
                     },
    "defaultInputModes":  [
                              "text/plain"
                          ],
    "defaultOutputModes":  [
                               "text/plain",
                               "application/json"
                           ],
    "skills":  [
                   {
                       "id":  "trail-to-product.inspect",
                       "name":  "Self-inspect",
                       "description":  "Inspect the subject through PMCR-O self-reference and return evidence-bound findings.",
                       "tags":  [
                                    "self-inspection",
                                    "process",
                                    "processes"
                                ],
                       "examples":  [
                                        "Inspect the process of packaging a finished Trail as a marketplace product and report findings with evidence."
                                    ]
                   },
                   {
                       "id":  "trail-to-product.guide",
                       "name":  "Guide",
                       "description":  "Name the next smallest step toward the goal. Recommendation only.",
                       "tags":  [
                                    "guide",
                                    "process",
                                    "processes"
                                ],
                       "examples":  [
                                        "What is the next smallest step for the process of packaging a finished Trail as a marketplace product?"
                                    ]
                   },
                   {
                       "id":  "trail-to-product.propose-fix",
                       "name":  "Propose fix",
                       "description":  "Draft a reversible fix for human review. Never applies it.",
                       "tags":  [
                                    "propose-fix",
                                    "process",
                                    "processes"
                                ],
                       "examples":  [
                                        "Propose a reversible fix for the process of packaging a finished Trail as a marketplace product."
                                    ]
                   }
               ]
}
