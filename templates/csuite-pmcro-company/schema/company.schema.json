{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectname.invalid/schemas/csuite-company-v1.json",
  "title": "Declarative C-suite PMCR-O company",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "company", "roles"],
  "properties": {
    "schema": {
      "const": "projectname.csuite-company/v1"
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "title", "domain", "mission", "canOrchestrate"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
          "title": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "mission": { "type": "string", "minLength": 1 },
          "canOrchestrate": { "type": "boolean" }
        }
      }
    }
  }
}
